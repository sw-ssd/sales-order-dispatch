# 環境變數範本（D31 config 逐檔 envconfig struct 對應）。
# 複製為 .env 後依環境調整；.env 已被 .gitignore 忽略，勿提交密鑰。
# 全部 key 對應 config/ 各檔 struct tag，tag 一概 envconfig:"KEY"。

# --- config/api.go (API) ---
ENV=development                # development | staging | production
API_ADDR=:3080
GOTENBERG_URL=http://localhost:3001
# developer 角色繞過 OpenFGA/RLS；production 必須 false（Server.Init fail-fast）
DEVELOPER_ACCOUNT_ENABLED=true

# --- config/database.go (Database) ---
# 業務連線：非 owner 的 app_rw（RLS 對其生效）
DATABASE_URL=postgres://app_rw:app_rw@localhost:5432/salesorder?sslmode=disable
# owner 連線：goose 遷移/seed/OpenFGA/平台域；未設時沿用 DATABASE_URL
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/salesorder?sslmode=disable

# --- config/cache.go (Cache) ---
VALKEY_ADDR=localhost:6379

# --- config/auth.go (Auth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3080/api/v1/auth/google/callback
# 限定 Workspace 網域（可留空 = 不限制）
GOOGLE_HOSTED_DOMAIN=
# production 必填且不可為預設值 dev-only-jwt-secret-change-me（Server.Init fail-fast）
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
SESSION_LIFETIME=720h          # Web session cookie 效期（30 天）
SESSION_SECURE=false
SESSION_SAME_SITE=lax          # lax | strict | none

# --- config/storage.go (Storage) ---
STORAGE_ROOT=./data/files

# --- config/observability.go (Observability) ---
LOG_LEVEL=info

# OpenFGA 內嵌授權引擎(D32)
OPENFGA_ENABLED=true
# OPENFGA_DATABASE_URL=postgres://... # 預設沿用 DATABASE_URL;僅內嵌 datastore 需獨立時設定
OPENFGA_STORE_NAME=sales_order
# 注意:OPENFGA_ENABLED=true(預設)時 server 啟動前需先建好 OpenFGA datastore schema
# (go run ./cmd/migrate up;版本表 openfga_goose_db_version);引擎/bootstrap 失敗一律拒絕啟動,不再靜默降級。

# --- config/platform.go (Platform) ---
# 平台營運工具;整組未設定則不掛載(開發環境可不設)
PLATFORM_JWT_SECRET=
# 獨立於 JWT_SECRET,兩者相同則拒絕啟動
PLATFORM_ALLOWED_EMAIL_DOMAIN=sowinsoft.com
PLATFORM_CONSOLE_URL=
# PLATFORM_COOKIE_DOMAIN=.example.com   # 正式設;開發留空(host-only cookie)

# --- 平台域 seed 預設值(執行期以 platform.settings 為準;上線前請改為真實值)---
# 首位平台操作者=可登入平台工具的白名單。**無預設值**:不設就跳過,避免把真實 email 種進白名單。
PLATFORM_SEED_OPERATOR_EMAIL=
PLATFORM_SEED_OPERATOR_NAME=
# 系統排程 actor(password_hash='!',不可登入)
PLATFORM_SEED_SYSTEM_ACTOR_EMAIL=system@platform.invalid
PLATFORM_DEFAULT_TRIAL_DAYS=14
PLATFORM_DEFAULT_GRACE_DAYS=7
PLATFORM_DEFAULT_LEAD_DAYS=14

# --- 方案價目 seed 預設(**佔位數字,上線前務必改為真實定價**;已有價目則不覆寫)---
SEED_PRICE_FREE_BASE=0
SEED_PRICE_FREE_SEAT=0
SEED_PRICE_STD_BASE=1500
SEED_PRICE_STD_SEAT=150
SEED_PRICE_PRO_BASE=4500
SEED_PRICE_PRO_SEAT=150
