# 默认公共包仍从官方 registry 获取
registry=https://registry.npmjs.org/

# 将 @ark-tailkit 作用域的包指向 Forgejo 注册表
@ark-tailkit:registry=https://apg-git.sowinsoft.com/api/packages/ssd/npm/

# 配置认证 Token（注意：URL 前不能加 https:）
# //apg-git.sowinsoft.com/api/packages/ssd/npm/:_authToken=${NPM_PACKAGES_TOKEN}
# 注意：上面的 _authToken 行在 project .npmrc 中會被 pnpm 忽略（防止 secret 隨倉入庫泄漏）。
# 請將其放到 user-level ~/.npmrc，或用 `pnpm config set` 設定（見上方 WARN 提示）。
# 本地開發：export NPM_PACKAGES_TOKEN=... 後執行 pnpm config set 一次即可。
