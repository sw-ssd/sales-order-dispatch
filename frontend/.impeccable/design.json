      "css": ".ds-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--border);border-radius:var(--radius-lg,.625rem);background:var(--card);color:var(--card-foreground);box-shadow:0 1px 3px 0 hsl(0 0% 0% /.05)}.ds-card-head{display:flex;flex-direction:column;gap:.375rem;background:var(--muted);padding:1rem 1.25rem}.ds-card-title{margin:0;font-size:1.125rem;font-weight:600;line-height:1;letter-spacing:-.01em}.ds-card-desc{margin:0;font-size:.875rem;color:var(--muted-foreground)}.ds-card-body{padding:1.25rem}.ds-card-text{margin:0;font-size:.875rem}.ds-card-foot{display:flex;align-items:center;gap:.5rem;background:var(--muted);padding:1rem 1.25rem;font-size:.875rem;color:var(--muted-foreground)}"
