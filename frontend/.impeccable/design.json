      "html": "<table class=\"ds-table\"><thead><tr><th>訂單編號</th><th>客戶</th><th>狀態</th><th class=\"ds-th-right\">動作</th></tr></thead><tbody><tr><td>A01000042</td><td>永和豆漿</td><td><span class=\"ds-badge\">待處理</span></td><td><span class=\"ds-actions\"><button class=\"ds-action\">編輯</button></span></td></tr><tr><td>A01000043</td><td>主廚商行</td><td><span class=\"ds-badge ds-badge-success\">已完成</span></td><td><span class=\"ds-actions\"><button class=\"ds-action\">檢視</button></span></td></tr></tbody></table>",
      "css": ".ds-table{width:100%;min-width:100%;border-collapse:collapse;font-size:.875rem;white-space:nowrap;align-middle}.ds-table th{background:var(--muted);padding:1rem .75rem;text-align:left;font-weight:600;color:var(--foreground);border-bottom:1px solid var(--border)}.ds-table .ds-th-right{text-align:right}.ds-table td{padding:.75rem;border-bottom:1px solid var(--border)}.ds-table tbody tr:last-child td{border-bottom:0}.ds-table tbody tr:hover{background:color-mix(in oklch,var(--muted) 50%,transparent)}"
