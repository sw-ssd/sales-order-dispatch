{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "~/components/ui": [
        "../packages/ui/src/ui/index.ts"
      ],
      "@ui": [
        "../packages/ui/src/ui/index.ts"
      ],
      "@ui/*": [
        "../packages/ui/src/ui/*"
      ],
      "@salesorder/ui": [
        "../packages/ui/src/ui/index.ts"
      ],
      "@salesorder/ui/*": [
        "../packages/ui/src/ui/*"
      ]
    },
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": [
    "src"
  ]
}